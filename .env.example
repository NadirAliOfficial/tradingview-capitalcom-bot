# Capital.com API credentials
# Get these from: Capital.com -> Settings -> API integrations
CAPITAL_API_KEY=your_api_key_here
CAPITAL_IDENTIFIER=your_email@example.com
CAPITAL_PASSWORD=your_password_here

# Set to "true" for demo account, "false" for live account
CAPITAL_DEMO=true

# Webhook security secret (any random string you choose)
# Must match the "secret" in your TradingView alert webhook URL
WEBHOOK_SECRET=change_this_to_a_random_secret

# Server port
PORT=5000

# Position sizing: percentage of account equity to use per trade
POSITION_SIZE_PERCENT=70

# Stop loss: percentage below entry price (0.45 = 0.45%)
STOP_LOSS_PERCENT=0.45
